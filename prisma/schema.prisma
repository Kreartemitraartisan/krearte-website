generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MODEL ====================
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  password     String?
  role         String    @default("customer")
  phone        String?
  address      String?
  city         String?
  postalCode   String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  orders       Order[]
  inquiries    Inquiry[]
  wishlists    Wishlist[]

  @@index([email])
  @@index([role])
}

// ==================== CATEGORY MODEL ====================
model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  imageUrl        String?
  collectionType  String    @default("wallcovering")
  parentId        String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([collectionType, isActive])
}

// ==================== MATERIAL MODEL ====================
model Material {
  id            String   @id @default(cuid())
  name          String
  category      String
  width         String?
  pricePerM2    Float
  designerPricePerM2 Float?
  resellerPricePerM2 Float?
  samplePriceA3 Float
  waste         Float
  stock         Float
  is25DEligible Boolean  @default(false)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  @@index([category])
  @@index([name])
}

// ==================== PRODUCT MODEL ====================
model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  category       String
  price          Float
  images         String[]
  collectionType String   @default("wallcovering")
  is25DEligible  Boolean  @default(false)
  availableMaterialIds String[]
  recommendedMaterialIds String[]
  stock          Int      @default(0)

  category_slug  String?  @map("category_slug")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  sizes          ProductSize[]
  orderItems     OrderItem[]
  wishlists      Wishlist[]

  @@map("Product")
  @@index([slug])
  @@index([category])
  @@index([collectionType])
  @@index([name])
}

// ==================== PRODUCT SIZE MODEL ====================
model ProductSize {
  id        String  @id @default(cuid())
  label     String
  price     Float
  stock     Int     @default(0)
  productId String
  // ✅ onDelete di sisi child (yang punya foreign key)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==================== ORDER MODEL ====================
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Customer info (denormalized for order history)
  email         String
  firstName     String
  lastName      String
  address       String
  city          String
  postalCode    String
  phone         String?
  country       String?   // ✅ NEW: Untuk ekspansi internasional
  notes         String?   // ✅ NEW: Catatan dari customer
  
  // Order items & totals
  items         OrderItem[]
  subtotal      Float
  shipping      Float     @default(0)
  total         Float
  
  // Status & payment
  status        String    @default("pending")                    // pending, processing, shipped, delivered, cancelled
  paymentMethod String    @default("WHATSAPP")                   // ✅ NEW: BCA, QRIS, WHATSAPP, CREDIT_CARD
  paymentStatus String    @default("pending_verification")       // ✅ NEW: pending_verification, paid, refunded
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([email])
  @@index([createdAt])
}

// ==================== ORDER ITEM MODEL ====================
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  // ✅ FIX: productId bisa null untuk sample orders
  productId String?
  
  name      String
  size      String
  price     Float
  quantity  Int        @default(1)

  width      Float? 
  height     Float?
  widthCm    Int?
  heightCm   Int?

  // ✅ Wallpaper-specific fields (untuk produksi & kalkulasi ulang)
  materialId   String?
  materialName String?
  pricePerM2   Float?
  wasteCost    Float?
  areaM2       Float?
  is25DAddOn   Boolean @default(false)
  
  // ✅ NEW: Flag untuk sample order
  isSample   Boolean @default(false)

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // ✅ FIX: onDelete Restrict hanya jika productId ada
  product  Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([materialId])
}

// ==================== INQUIRY MODEL ====================
model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  dimensions  String?
  timeline    String?
  budget      String?
  message     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  User   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([userId])
}

// ==================== WISHLIST MODEL ====================
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  // ✅ onDelete di sisi child
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ==================== ADMIN MODEL ====================
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ==================== GALLERY MODEL ====================
model Gallery {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  category    String   @default("general")
  description String?
  order       Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isFeatured])
  @@index([order])
}

// ==================== SETTINGS MODEL ====================
model Settings {
  id                        String   @id @default("default")
  storeName                 String   @default("Krearte")
  storeEmail                String   @default("hello@krearte.com")
  storePhone                String?
  storeAddress              String?
  storeDescription          String?
  currency                  String   @default("IDR")
  timezone                  String   @default("Asia/Jakarta")
  instagram                 String?
  facebook                  String?
  twitter                   String?
  website                   String?
  freeShippingThreshold     Float    @default(5000000)
  domesticShippingRate      Float    @default(50000)
  internationalShippingRate Float    @default(500000)
  processingTime            String   @default("3-5")
  metaTitle                 String   @default("Krearte | Luxury Wallcoverings")
  metaDescription           String?
  keywords                  String?
  ogImage                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}